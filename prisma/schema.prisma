generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String   @default("STAFF") // 'OWNER' | 'STAFF'
  pin_hash  String   // Quick 4-digit POS unlock PIN hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id             String         @id @default(uuid())
  name           String
  phone          String         @unique
  email          String?
  address        String?
  dob            DateTime?
  loyalty_points Int            @default(0)
  prescriptions  Prescription[]
  orders         Order[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Prescription {
  id              String    @id @default(uuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  optometristName String?
  
  // Right Eye (OD - Oculus Dexter)
  od_sph          Float?    // Sphere
  od_cyl          Float?    // Cylinder
  od_axis         Int?      // Axis (1-180)
  od_add          Float?    // Addition for presbyopia

  // Left Eye (OS - Oculus Sinister)
  os_sph          Float?    // Sphere
  os_cyl          Float?    // Cylinder
  os_axis         Int?      // Axis (1-180)
  os_add          Float?    // Addition for presbyopia

  // Pupillary Distance & Lens specs
  pd_distance     Float?    // Distance PD (mm)
  pd_near         Float?    // Near PD (mm)
  lens_type       String?   // 'SINGLE_VISION' | 'BIFOCAL' | 'PROGRESSIVE' | 'BLUE_CUT' | 'PHOTOCHROMIC'
  notes           String?
  
  orders          Order[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model InventoryItem {
  id                  String      @id @default(uuid())
  shopId              String      @default("default")
  sku                 String
  barcode             String?
  type                String      // 'FRAME' | 'LENS' | 'CONTACT_LENS' | 'ACCESSORY'
  brand               String
  model               String?
  color               String?
  size                String?     // e.g. "52-18-140"
  lens_index          String?     // e.g. "1.56", "1.61", "1.67", "1.74"
  cost_price          Float
  selling_price       Float
  gst_rate            Float       @default(12.0) // Indian GST % (typically 12% or 18%)
  stock_quantity      Int         @default(0)
  min_alert_threshold Int         @default(5)
  image_url           String?
  
  orderItems          OrderItem[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([shopId])
}

model Order {
  id               String        @id @default(uuid())
  bill_no          String        @unique // e.g. "VP-2026-0001"
  shopId           String        @default("default")
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id])
  prescriptionId   String?
  prescription     Prescription? @relation(fields: [prescriptionId], references: [id])
  
  status           String        @default("PLACED") // 'PLACED' | 'LENS_PROCESSING' | 'FITTING' | 'READY_FOR_PICKUP' | 'DELIVERED' | 'CANCELLED'
  total_amount     Float         // Subtotal before discount & tax
  discount_amount  Float         @default(0)
  tax_amount       Float         @default(0) // GST Amount
  final_payable    Float         // total_amount - discount_amount + tax_amount
  paid_amount      Float         @default(0)
  balance_amount   Float         @default(0)
  delivery_due_date DateTime?
  
  items            OrderItem[]
  payments         Payment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([shopId])
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId          String?
  item            InventoryItem? @relation(fields: [itemId], references: [id])
  quantity        Int            @default(1)
  unit_price      Float
  coating_charges Float          @default(0)
  fitting_charges Float          @default(0)
  subtotal        Float          // (unit_price * quantity) + coating_charges + fitting_charges
  createdAt       DateTime       @default(now())
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          String   // 'CASH' | 'UPI' | 'CARD'
  amount          Float
  payment_type    String   // 'ADVANCE' | 'BALANCE' | 'FULL'
  transaction_ref String?  // UPI Ref / UTR / Card Auth Code
  createdAt       DateTime @default(now())
}

model StoreSetting {
  id             String   @id @default("default")
  storeName      String   @default("VisionPulse Eyewear Studio")
  tagline        String?  @default("Precision Optometry & Designer Eyewear")
  gstin          String?  @default("27AABCV1234F1Z8")
  phone          String?  @default("+91 98201 12345")
  email          String?  @default("care@visionpulse.in")
  address        String?  @default("Shop 4 & 5, Galleria Arcade, Hiranandani Gardens, Powai, Mumbai - 400076")
  currencySymbol String   @default("₹")
  currencyCode   String   @default("INR")
  defaultGstRate Float    @default(12.0)
  receiptFooter  String?  @default("1-Year warranty against frame manufacturing defects. Spectacle power adaptation guarantee for 14 days.")
  updatedAt      DateTime @updatedAt
}
