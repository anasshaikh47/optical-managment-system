generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String   @default("STAFF") // 'OWNER' | 'PHARMACIST' | 'STAFF'
  pin_hash  String   // Quick 4-digit POS unlock PIN hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id             String         @id @default(uuid())
  name           String
  phone          String         @unique
  email          String?
  address        String?
  dob            DateTime?
  loyalty_points Int            @default(0)
  prescriptions  Prescription[]
  orders         Order[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Prescription {
  id                 String    @id @default(uuid())
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  // Patient & Doctor Information
  patientName        String?
  patientAge         Int?
  doctorName         String?
  clinicOrHospital   String?
  doctorRegNo        String?
  prescriptionImage  String?   // optional upload (Base64 data URL / storage URL)
  dosageInstructions String?   // Morning-Afternoon-Night e.g., "1-0-1", before/after meals
  notes              String?   // Additional clinical notes or special instructions
  
  orders             Order[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Medicine {
  id                  String      @id @default(uuid())
  sku                 String      @unique // e.g. "MED-001"
  barcode             String?     @unique
  name                String      // Brand name e.g. "Dolo 650", "Augmentin 625 Duo"
  genericSaltName     String      // Composition e.g. "Paracetamol (650mg)"
  manufacturer        String      // e.g. "Micro Labs Ltd", "GSK"
  packType            String      @default("Strip") // Strip / Bottle / Box / Syringe / Ointment
  tabletsPerStrip     Int         @default(10) // Units per pack for loose tablet conversion
  hsnCode             String?     @default("3004")
  rackLocation        String?     // e.g. "Rack A-12"
  minStockAlert       Int         @default(10)
  scheduleType        String      @default("GENERAL") // 'GENERAL' | 'SCHEDULE_H' | 'SCHEDULE_H1' | 'OTC'
  isScheduleH         Boolean     @default(false)
  image_url           String?
  
  // Default / Active primary batch details
  batchNumber         String      @default("BT-001")
  expiryDate          String      @default("12/2026") // MM/YYYY
  mrp                 Float       @default(0)
  purchaseRate        Float       @default(0)
  saleRate            Float       @default(0)
  stripQuantity       Int         @default(0)
  looseTabletQuantity Int         @default(0)
  gstRate             Float       @default(12.0) // 5%, 12%, 18%
  
  batches             Batch[]
  orderItems          OrderItem[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Batch {
  id                  String    @id @default(uuid())
  medicineId          String
  medicine            Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber         String
  expiryDate          String    // MM/YYYY
  mrp                 Float
  purchaseRate        Float
  saleRate            Float
  stripQuantity       Int       @default(0)
  looseTabletQuantity Int       @default(0)
  gstRate             Float     @default(12.0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Order {
  id                String        @id @default(uuid())
  bill_no           String        @unique // e.g. "RX-2026-0001"
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  prescriptionId    String?
  prescription      Prescription? @relation(fields: [prescriptionId], references: [id])
  
  patientName       String?
  doctorName        String?
  status            String        @default("COMPLETED") // 'COMPLETED' | 'PENDING_RX' | 'READY_FOR_PICKUP' | 'CANCELLED'
  total_amount      Float         // Subtotal before discount & tax
  discount_amount   Float         @default(0)
  tax_amount        Float         @default(0) // GST Amount
  final_payable     Float         // total_amount - discount_amount + tax_amount
  paid_amount       Float         @default(0)
  balance_amount    Float         @default(0)
  delivery_due_date DateTime?
  
  items             OrderItem[]
  payments          Payment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model OrderItem {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineId      String
  medicine        Medicine  @relation(fields: [medicineId], references: [id])
  batchNumber     String?
  expiryDate      String?
  packType        String?   @default("Strip")
  unitType        String    @default("STRIP") // 'STRIP' | 'LOOSE_TABLET' | 'UNIT'
  quantity        Int       @default(1)
  unit_price      Float
  subtotal        Float
  gstRate         Float     @default(12.0)
  createdAt       DateTime  @default(now())
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          String   // 'CASH' | 'UPI' | 'CARD'
  amount          Float
  payment_type    String   // 'ADVANCE' | 'BALANCE' | 'FULL'
  transaction_ref String?  // UPI Ref / UTR / Card Auth Code
  createdAt       DateTime @default(now())
}

model StoreSetting {
  id             String   @id @default("default")
  storeName      String   @default("PharmaPulse Chemist & Druggist")
  tagline        String?  @default("High-Efficiency Pharmacy & Clinical Store ERP")
  gstin          String?  @default("27AABCP9876F1Z2")
  dlNumber       String?  @default("DL-20B/21B-458920") // Drug License No.
  phone          String?  @default("+91 98201 12345")
  email          String?  @default("care@pharmapulse.in")
  address        String?  @default("Shop 10 & 11, Central Avenue, Powai, Mumbai - 400076")
  currencySymbol String   @default("₹")
  currencyCode   String   @default("INR")
  defaultGstRate Float    @default(12.0)
  receiptFooter  String?  @default("Medicines sold against valid registered Doctor Prescription. Please check batch number & expiry date before consumption.")
  updatedAt      DateTime @updatedAt
}
