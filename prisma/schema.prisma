generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String   @default("STAFF")
  pin_hash  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id             String         @id @default(uuid())
  shopId         String         @default("default")
  userId         String?        @default("default")
  name           String
  phone          String         @unique
  email          String?
  address        String?
  dob            DateTime?
  loyalty_points Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orders         Order[]
  prescriptions  Prescription[]

  @@index([shopId])
  @@index([shopId, createdAt])
}

model Prescription {
  id              String   @id @default(uuid())
  customerId      String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lens_type       String?
  od_add          Float?
  od_axis         Int?
  od_cyl          Float?
  od_sph          Float?
  optometristName String?
  os_add          Float?
  os_axis         Int?
  os_cyl          Float?
  os_sph          Float?
  pd_distance     Float?
  pd_near         Float?
  orders          Order[]
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id                  String      @id @default(uuid())
  shopId              String      @default("default")
  sku                 String
  barcode             String?
  type                String
  brand               String
  model               String?
  color               String?
  size                String?
  lens_index          String?
  cost_price          Float
  selling_price       Float
  gst_rate            Float       @default(12.0)
  stock_quantity      Int         @default(0)
  min_alert_threshold Int         @default(5)
  image_url           String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  orderItems          OrderItem[]

  @@index([shopId])
  @@index([shopId, createdAt])
}

model Order {
  id                String        @id @default(uuid())
  bill_no           String        @unique
  customerId        String
  prescriptionId    String?
  status            String        @default("PLACED")
  total_amount      Float
  discount_amount   Float         @default(0)
  tax_amount        Float         @default(0)
  final_payable     Float
  paid_amount       Float         @default(0)
  balance_amount    Float         @default(0)
  delivery_due_date DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  shopId            String        @default("default")
  userId            String?       @default("default")
  customerName      String?
  customerPhone     String?
  itemsJson         Json?
  subtotal          Float?
  taxAmount         Float?        @default(0)
  totalAmount       Float?
  paidAmount        Float?        @default(0)
  pendingAmount     Float?        @default(0)
  customer          Customer      @relation(fields: [customerId], references: [id])
  prescription      Prescription? @relation(fields: [prescriptionId], references: [id])
  items             OrderItem[]
  payments          Payment[]

  @@index([shopId])
  @@index([shopId, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  quantity        Int            @default(1)
  unit_price      Float
  subtotal        Float
  createdAt       DateTime       @default(now())
  coating_charges Float          @default(0)
  fitting_charges Float          @default(0)
  itemId          String?
  item            InventoryItem? @relation(fields: [itemId], references: [id])
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String
  method          String
  amount          Float
  payment_type    String
  transaction_ref String?
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model StoreSetting {
  id             String   @id @default("default")
  storeName      String   @default("VisionPulse Eyewear Studio")
  tagline        String?  @default("Precision Optometry & Designer Eyewear")
  gstin          String?  @default("27AABCV1234F1Z8")
  phone          String?  @default("+91 98201 12345")
  email          String?  @default("care@visionpulse.in")
  address        String?  @default("Shop 4 & 5, Galleria Arcade, Hiranandani Gardens, Powai, Mumbai - 400076")
  currencySymbol String   @default("₹")
  currencyCode   String   @default("INR")
  defaultGstRate Float    @default(12.0)
  receiptFooter  String?  @default("1-Year warranty against frame manufacturing defects. Spectacle power adaptation guarantee for 14 days.")
  updatedAt      DateTime @updatedAt
}
